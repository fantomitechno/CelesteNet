<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>CelesteNet.Server.APIModule</AssemblyName>
    <RootNamespace>Celeste.Mod.CelesteNet.Server.API</RootNamespace>
  </PropertyGroup>

  <Import Project="..\CelesteNet.props" />

  <ItemGroup>
    <ProjectReference Include="..\CelesteNet.Server.SqliteModule\CelesteNet.Server.SqliteModule.csproj" />
    <ProjectReference Include="..\CelesteNet.Server.FrontendModule\CelesteNet.Server.FrontendModule.csproj" />
    <!--
      this is a build of [websocket-sharp with custom headers](https://github.com/felixhao28/websocket-sharp)
      i just had to merge main into it (since it was severely out of date) and converted the .csproj to build against .net 7
      -->
    <Reference Include="websocket-sharp-customheaders.dll" HintPath="..\lib\websocket-sharp-customheaders.dll" />
  </ItemGroup>

</Project>
